# "We learn" Supabase project (lnhomkdmbcbfpathdyvo) - standalone backend
# for this MCP server, not connected to the main Xcluice app.
SUPABASE_URL=https://lnhomkdmbcbfpathdyvo.supabase.co
# Service role key - found in Supabase dashboard > Project Settings > API
# KEEP THIS SECRET. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# A long random string you make up yourself. This acts as your MCP server's
# password since Claude's custom connector UI doesn't support simple API
# keys on personal plans - it goes in the URL path instead.
# Generate one with: openssl rand -hex 32
MCP_SECRET=
